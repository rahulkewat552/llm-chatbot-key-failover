# Comma-separated key pool (at least 2). Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-key,your-second-key

# LiteLLM model name used for every key.
LLM_MODEL=gemini/gemini-flash-lite-latest

# SQLite location. Use a path on a persistent volume/disk (/data in Docker and on Render).
DATABASE_URL=sqlite:////data/app.db

# Comma-separated list of frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000

# true enables the X-Simulate-Failure test header (must be true on the deployed backend).
ENABLE_FAILURE_SIMULATION=true

# Optional
CACHE_TYPE=local
CACHE_DIR=/data/llm_cache
REQUEST_TIMEOUT=30
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.

# Frontend build-time API URL (read by docker compose / the frontend build).
VITE_API_URL=http://localhost:8000
